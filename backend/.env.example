# --- Django -------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# Comma-separated. On Vercel, *.vercel.app is added automatically.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Data ---------------------------------------------------------------------
# Local: docker-compose Postgres. Vercel: Neon (Marketplace) sets this; prefer the pooled URL.
DATABASE_URL=postgres://postgres:postgres@db:5432/truckroute
# Seconds to keep DB connections open (0 = per request; recommended on serverless).
DB_CONN_MAX_AGE=0
# Optional on Vercel (e.g. Upstash Redis, rediss://…). Without it, caches are per instance.
REDIS_URL=redis://redis:6379/0

# --- Providers (server-side only; never exposed to the browser) ----------------
TOMTOM_API_KEY=
ORS_API_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com
# live | fake  (fake is test-only and refused when DEBUG=False)
PROVIDERS_MODE=live

# --- Browser access -----------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional regexes, e.g. ^https://truck-web-.*\.vercel\.app$ for preview deployments
CORS_ALLOWED_ORIGIN_REGEXES=

# --- Jobs / deploy ------------------------------------------------------------
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to the daily purge endpoint.
CRON_SECRET=
# Set to 1 to skip `migrate` in the Vercel build step.
SKIP_MIGRATIONS=0
